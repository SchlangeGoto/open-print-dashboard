# Application
PROJECT_NAME=OpenPrintDashboard
# Generate one with: openssl rand -hex 32
SECRET_KEY=changethis
# Encrypts the stored Bambu Cloud credentials. Leave empty to derive the key
# from SECRET_KEY. Set a separate value before rotating SECRET_KEY so the
# stored Bambu login survives the rotation.
BAMBU_CREDENTIALS_KEY=

# Optional bootstrap of the first admin account. Leave empty to create the
# first account through the setup wizard instead.
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=

# Backend
FASTAPI_ENV=development
FRONTEND_HOST=http://localhost:3000
API_V1_STR=/api/v1

# Postgres
POSTGRES_USER=opd
# Change this before exposing the stack publicly.
POSTGRES_PASSWORD=changethis
POSTGRES_DB=openprintdashboard
DATABASE_URL=postgresql://opd:changethis@localhost:5432/openprintdashboard

# Bambu Cloud MQTT broker. Global accounts use us.mqtt.bambulab.com;
# mainland China accounts use cn.mqtt.bambulab.com.
BAMBU_CLOUD_MQTT_HOST=us.mqtt.bambulab.com
BAMBU_CLOUD_MQTT_PORT=8883

# Optional LAN printer bootstrap (normally configured through the setup
# wizard). Leave empty to use Bambu Cloud only.
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=

# Frontend
# Baked into the frontend at build time. Use the public API URL in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set true to serve the in-browser demo (mock data, no backend) in Docker.
NEXT_PUBLIC_DEMO_MODE=false

# Email (Mailpit captures these in local development)
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_TLS=False
EMAILS_FROM_EMAIL=info@example.com
