# Application
PROJECT_NAME=OpenPrintDashboard
# Generate one with: openssl rand -hex 32
SECRET_KEY=changethis

# Optional bootstrap of the first admin account. Leave empty to create the
# first account through the setup wizard instead.
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=

# Backend
FASTAPI_ENV=development
FRONTEND_HOST=http://localhost:3000
API_V1_STR=/api/v1

# Postgres
POSTGRES_USER=opd
POSTGRES_PASSWORD=changethis
POSTGRES_DB=openprintdashboard
DATABASE_URL=postgresql://opd:changethis@localhost:5432/openprintdashboard

# Optional printer defaults (normally configured through the setup wizard)
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=

# Email (Mailpit captures these in local development)
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_TLS=False
EMAILS_FROM_EMAIL=info@example.com
