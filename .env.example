# Application
PROJECT_NAME=OpenPrintDashboard
# Leave empty (or keep the placeholder) and a random key is generated on
# first start and stored in the backend_data volume. Generate one manually
# with: openssl rand -hex 32
SECRET_KEY=changethis
# Optional path for the generated secret file. Defaults to data/secret_key.
SECRET_KEY_FILE=
# Encrypts the stored Bambu Cloud credentials. Leave empty to derive the key
# from SECRET_KEY. Set a separate value before rotating SECRET_KEY so the
# stored Bambu login survives the rotation. Removing this value after it was
# used makes the stored login unreadable; sign in again.
BAMBU_CREDENTIALS_KEY=

# Optional bootstrap of the first admin account. Leave empty to create the
# first account through the setup wizard instead.
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=

# Backend
# Leave empty for localhost; set the public URL in production.
FRONTEND_HOST=
API_V1_STR=/api/v1
# Token lifetimes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Postgres
POSTGRES_USER=opd
# Change this before exposing the stack publicly.
POSTGRES_PASSWORD=changethis
POSTGRES_DB=openprintdashboard
DATABASE_URL=postgresql://opd:changethis@localhost:5432/openprintdashboard
# Only for backend/scripts/test.sh; must end in _test.
TEST_DATABASE_URL=postgresql://opd:changethis@localhost:5432/openprintdashboard_test

# Bambu Cloud MQTT broker. Global accounts use us.mqtt.bambulab.com;
# mainland China accounts use cn.mqtt.bambulab.com.
BAMBU_CLOUD_MQTT_HOST=us.mqtt.bambulab.com
BAMBU_CLOUD_MQTT_PORT=8883

# Frontend
# Baked into the frontend at build time. Use the public API URL in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set true to serve the in-browser demo (mock data, no backend) in Docker.
NEXT_PUBLIC_DEMO_MODE=false

# Email (Mailpit captures these in local development)
# Leave empty to disable email. Local development with Mailpit:
# SMTP_HOST=localhost, SMTP_PORT=11025, SMTP_TLS=False, EMAILS_FROM_EMAIL=info@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=False
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=
